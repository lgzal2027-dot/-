          "maxLength": 150
        },
        "role": {
          "type": "string",
          "enum": ["moderator", "super_admin"]
        },
        "assignedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "role", "assignedBy", "createdAt", "updatedAt"]
    },
