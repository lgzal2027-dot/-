    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Payment transaction record for unlocking contact info or ad services.",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
