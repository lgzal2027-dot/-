{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Public and general user account data and current role status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID of the user.",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "description": "Display name or nickname in Arabic or English.",
          "minLength": 2,
          "maxLength": 80
        },
        "gender": {
          "type": "string",
          "description": "User gender.",
          "enum": ["male", "female", "unspecified"]
        },
        "countryCode": {
          "type": "string",
          "description": "ISO country code (focus on Gulf and Arab countries).",
          "minLength": 2,
          "maxLength": 10
        },
        "cityName": {
          "type": "string",
          "description": "City name.",
          "minLength": 1,
          "maxLength": 80
        },
        "role": {
          "type": "string",
          "description": "System role: regular user, moderator, or super admin.",
          "enum": ["user", "moderator", "super_admin"]
        },
        "accountStatus": {
          "type": "string",
          "description": "Account moderation state.",
          "enum": ["active", "suspended", "restricted", "banned"]
        },
        "restrictionReason": {
          "type": "string",
          "description": "Reason for temporary account restriction.",
          "maxLength": 500
        },
        "restrictionUntil": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp until which the restriction is active."
        },
        "bannedReason": {
          "type": "string",
          "description": "Reason for account ban.",
          "maxLength": 500
        },
        "bannedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Timestamp when account was banned."
        },
        "emailVerified": {
          "type": "boolean",
          "description": "Whether user email is verified."
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 150,
          "description": "User email address."
        },
        "adsCount": {
          "type": "integer",
          "description": "Total number of ads created by this user."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server creation timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server update timestamp."
        }
      },
      "required": [
        "uid",
        "displayName",
        "gender",
        "countryCode",
        "cityName",
        "role",
        "accountStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated PII data for a user account (email, phone, private notes).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "phone", "updatedAt"]
    },
    "StaffRole": {
      "title": "StaffRole",
      "description": "Authoritative RBAC record assigning moderator or super_admin permissions.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
