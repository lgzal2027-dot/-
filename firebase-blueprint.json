        "adId",
        "userId",
        "advertiserName",
        "title",
        "gender",
        "age",
        "maritalStatus",
        "marriageType",
        "countryCode",
        "countryNameAr",
        "countryNameEn",
        "regionId",
        "regionLabelAr",
        "regionNameAr",
        "subRegionId",
