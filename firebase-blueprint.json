        "subRegionNameAr",
        "cityNameAr",
        "cityNameEn",
        "details",
        "partnerRequirements",
        "hasPhotos",
        "primaryPhotoUrl",
        "photoFileId",
        "contactChannelsSummary",
        "status",
        "reviewStatus",
