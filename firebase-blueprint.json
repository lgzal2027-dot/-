          "enum": [
            "ban_user",
            "unban_user",
            "restrict_user",
            "unrestrict_user",
            "approve_ad",
            "reject_ad",
            "pause_ad",
            "resume_ad",
            "delete_ad",
            "delete_ad_photo",
            "assign_role",
            "revoke_role",
            "update_settings"
          ]
        },
        "targetType": {
          "type": "string",
          "enum": ["user", "ad", "staff", "settings"]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "targetName": {
          "type": "string",
          "maxLength": 120
        },
        "reason": {
          "type": "string",
          "maxLength": 500
        },
        "durationHours": {
          "type": "integer"
        },
        "details": {
          "type": "string",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "logId",
        "adminUid",
        "adminEmail",
        "actionType",
        "targetType",
        "targetId",
        "targetName",
        "reason",
        "durationHours",
        "details",
        "createdAt"
      ]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Customer support tickets, reports, complaints, and inquiries submitted by users or visitors.",
      "type": "object",
      "properties": {
        "ticketId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "userDisplayName": {
          "type": "string",
          "maxLength": 80
        },
        "userEmail": {
          "type": "string",
          "maxLength": 150
        },
        "userPhone": {
          "type": "string",
          "maxLength": 30
        },
        "type": {
          "type": "string",
          "enum": ["inquiry", "complaint", "report_ad", "report_user", "auth_issue", "payment_issue"]
        },
        "subject": {
          "type": "string",
          "minLength": 2,
          "maxLength": 150
        },
        "details": {
          "type": "string",
          "minLength": 5,
          "maxLength": 3000
        },
        "attachmentUrl": {
          "type": "string",
          "maxLength": 350000
        },
        "status": {
          "type": "string",
          "enum": ["new", "in_progress", "resolved", "closed"]
        },
        "adminNote": {
          "type": "string",
          "maxLength": 1000
        },
        "replies": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "closedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ticketId",
        "userId",
        "userDisplayName",
        "userEmail",
        "type",
        "subject",
        "details",
        "status",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Public/general user profile and role status."
    },
    "/user_private/{userId}": {
      "schema": "UserPrivate",
      "description": "Strictly isolated PII (email, phone) for each user."
    },
    "/staff_roles/{userId}": {
      "schema": "StaffRole",
      "description": "Trusted RBAC table assigning moderator and super_admin roles."
    },
    "/ads/{adId}": {
      "schema": "MarriageAd",
      "description": "Marriage advertisements without raw contact details."
    },
    "/ad_photos/{photoId}": {
      "schema": "AdPhoto",
      "description": "Photo records associated with marriage ads."
    },
    "/ad_contacts/{adId}": {
      "schema": "AdContact",
      "description": "Isolated contact details for each ad, accessible only to owner, staff, or authorized payers."
    },
    "/payments/{paymentId}": {
      "schema": "PaymentRecord",
      "description": "Payment records submitted by users and reviewed by staff."
    },
    "/contact_access/{accessId}": {
      "schema": "ContactAccessGrant",
      "description": "Verified access grants allowing a user to read an ad's contact methods."
    },
    "/admin_settings/{settingKey}": {
      "schema": "AdminSettings",
      "description": "Global platform configuration controlled by the Super Admin."
    },
    "/ui_settings/{configId}": {
      "schema": "UiConfigSettings",
      "description": "Dynamic UI settings for top banner, news ticker, ad cards, marriage types, and customer service."
    },
    "/admin_audit_logs/{logId}": {
      "schema": "AdminAuditLog",
      "description": "Audit trails for moderation actions, bans, and ad reviews."
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "Customer support tickets, reports, complaints, and inquiries submitted by users or visitors."
    }
  }
}
